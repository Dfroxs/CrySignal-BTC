[Unit]
# __USER__ and __APP_DIR__ are placeholders that deploy/setup.sh substitutes
# before installing. They are NOT systemd's %i — this is a plain unit, not a
# template. APP_DIR is substituted rather than assumed to be /home/<user>,
# because root's home is /root and providers that hand out root logins (Kamatera
# among them) would otherwise get a unit pointing at a directory that does not
# exist, failing every 30 seconds under Restart=always.
Description=SpotSignal BTC/USDT paper-trading bot
Documentation=https://github.com/Dfroxs/CrySignal-BTC
# The first cycle fetches from six external APIs; without network-online the
# unit starts before DNS is up and the whole cycle fails on a cold boot.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/venv/bin/python run_bot.py --loop 60

# A multi-week validation run must not end quietly. Restart on any exit,
# including a clean one, and keep trying — a network outage should cost one
# cycle, not the whole sample.
Restart=always
RestartSec=30

# The engine reads the session bump from the CANDLE's UTC hour, so it is
# unaffected by this. The loop's :01 / :31 schedule follows local time, so
# pinning UTC makes cycle times predictable and comparable to cycle_log.
Environment=TZ=UTC
Environment=PYTHONUNBUFFERED=1

StandardOutput=append:__APP_DIR__/paper_run.log
StandardError=append:__APP_DIR__/paper_run.log

# Give an in-flight cycle time to finish writing to SQLite before SIGKILL.
KillSignal=SIGINT
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
