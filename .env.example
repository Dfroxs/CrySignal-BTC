# Copy to .env and fill in values. All fields are optional.

# Trading parameters
ACCOUNT_BALANCE=1000
FUTURES_BALANCE=500

# Threshold overrides — LEAVE COMMENTED OUT unless you want a fixed bar.
# Setting either one pins the threshold and switches OFF the adaptive
# controller entirely (frequency + 24h/72h win-rate windows in
# signals/market_data.py). Tuned defaults live in config.py.
#SIGNAL_THRESHOLD=5.2
#SPOT_THRESHOLD=4.3

# Loop mode: run every N minutes (used with --loop flag)
LOOP_INTERVAL=60

# Telegram alerts (all signals including HOLD + position updates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
