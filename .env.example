# Copy to .env and fill in values. All fields are optional.

# Trading parameters
ACCOUNT_BALANCE=1000
FUTURES_BALANCE=500
SIGNAL_THRESHOLD=5.2

# Loop mode: run every N minutes (used with --loop flag)
LOOP_INTERVAL=60

# Telegram alerts (BUY/SELL signals only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord webhook alerts
DISCORD_WEBHOOK_URL=
